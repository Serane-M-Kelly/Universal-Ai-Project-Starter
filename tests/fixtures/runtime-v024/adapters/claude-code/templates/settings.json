{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      {{CODE_ROOT_JSON}}
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.production)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials.*)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.*.local)",
      "Edit(//**/.env.development)",
      "Edit(//**/.env.test)",
      "Edit(//**/.env.staging)",
      "Edit(//**/.env.production)",
      "Edit(//**/secrets/**)",
      "Edit(//**/credentials.*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false
  }
}
