{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/universal-ai-project-starter/agent-strategy.schema.json",
  "title": "Universal AI Project Starter agent strategy frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_version",
    "status",
    "approved_by",
    "approved_at",
    "source_backlog_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "strategy_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "approved"]
    },
    "approved_by": {
      "type": ["string", "null"]
    },
    "approved_at": {
      "type": ["string", "null"]
    },
    "source_backlog_version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "covers", "mode", "agent_id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^STR-[0-9]{3,}$"
          },
          "covers": {
            "description": "Phases ou résultats couverts. Le motif TSK- est volontairement absent : aucune stratégie ne peut recommander un agent pour une micro-tâche.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(PH-[0-9]+|BLG-[0-9]{3,})$"
            }
          },
          "mode": {
            "enum": ["main_conversation", "skill_or_profile", "core_agent", "custom_agent"]
          },
          "agent_id": {
            "type": ["string", "null"],
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
