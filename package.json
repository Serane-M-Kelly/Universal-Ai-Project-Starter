{
  "name": "universal-ai-project-starter",
  "version": "0.25.1",
  "private": true,
  "description": "CLI and universal contracts for safe AI-assisted project workspaces",
  "type": "module",
  "bin": {
    "ai-project": "dist/index.js"
  },
  "files": [
    "dist/",
    "core/",
    "profiles/",
    "adapters/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "verify:package": "node scripts/verify-package.mjs",
    "validate": "npm run check && npm test && npm run verify:package",
    "cli": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
