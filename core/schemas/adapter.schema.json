{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:universal-ai-project-starter:adapter:v1",
  "title": "Universal AI Project Starter adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "compatibility", "launch", "directories", "skills", "agents", "outputs"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "label", "vendor", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "label": { "type": "string", "minLength": 1 },
        "vendor": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_schema_versions", "profiles"],
      "properties": {
        "project_schema_versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              { "const": "*" },
              { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
            ]
          }
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_directory", "command", "requires_trust"],
      "properties": {
        "working_directory": { "enum": ["workspace", "code"] },
        "command": { "type": "string", "minLength": 1 },
        "requires_trust": { "type": "boolean" }
      }
    },
    "directories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "ownership"],
      "properties": {
        "destination": { "type": "string", "minLength": 1 },
        "ownership": { "const": "starter-managed" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "format", "ownership"],
      "properties": {
        "destination": { "type": "string", "minLength": 1 },
        "format": { "enum": ["codex-toml", "claude-markdown"] },
        "ownership": { "const": "starter-managed" }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "template", "ownership"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "template": { "type": "string", "minLength": 1 },
          "ownership": { "enum": ["user-owned", "starter-managed"] }
        }
      }
    }
  }
}
