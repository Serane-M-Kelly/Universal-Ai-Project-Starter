{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/universal-ai-project-starter/agent-catalog.schema.json",
  "title": "Universal AI Project Starter agent catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
