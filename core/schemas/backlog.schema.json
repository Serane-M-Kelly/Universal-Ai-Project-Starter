{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/universal-ai-project-starter/backlog.schema.json",
  "title": "Universal AI Project Starter backlog frontmatter (schema_version 2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backlog_version",
    "status",
    "approved_by",
    "approved_at",
    "source_brief_version",
    "source_setup_report",
    "last_reviewed_at",
    "id_allocation",
    "phases",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "backlog_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["draft", "approved"]
    },
    "approved_by": {
      "type": ["string", "null"]
    },
    "approved_at": {
      "type": ["string", "null"]
    },
    "source_brief_version": {
      "type": "integer",
      "minimum": 1
    },
    "source_setup_report": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed_at": {
      "type": ["string", "null"]
    },
    "id_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_phase", "next_item", "next_task", "next_evidence"],
      "properties": {
        "next_phase": { "type": "integer", "minimum": 0 },
        "next_item": { "type": "integer", "minimum": 1 },
        "next_task": { "type": "integer", "minimum": 1 },
        "next_evidence": { "type": "integer", "minimum": 1 }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "goal", "disposition", "prepared_by", "prepared_at"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PH-[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\n\\r]+$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\n\\r]+$"
          },
          "disposition": {
            "enum": ["active", "retired"]
          },
          "prepared_by": {
            "type": ["string", "null"]
          },
          "prepared_at": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "phase",
          "order",
          "stage",
          "disposition",
          "required",
          "priority",
          "depends_on",
          "derived_from",
          "legacy_work_items",
          "outcome_accepted_by",
          "outcome_accepted_at",
          "tasks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BLG-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\n\\r]+$"
          },
          "phase": {
            "type": "string",
            "pattern": "^PH-[0-9]+$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "enum": ["candidate", "ready"]
          },
          "disposition": {
            "enum": ["active", "deferred", "retired"]
          },
          "required": {
            "type": "boolean"
          },
          "priority": {
            "enum": ["P0", "P1", "P2"]
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^BLG-[0-9]{3,}$"
            }
          },
          "derived_from": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^BLG-[0-9]{3,}$"
            }
          },
          "legacy_work_items": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^WORK-[0-9]{3,}$"
            }
          },
          "outcome_accepted_by": {
            "type": ["string", "null"]
          },
          "outcome_accepted_at": {
            "type": ["string", "null"]
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "category",
                "required",
                "disposition",
                "derived_from",
                "origin",
                "source_work",
                "origin_reason",
                "added_at",
                "blocked_reason",
                "dropped_by",
                "dropped_at",
                "dropped_reason",
                "evidence_log"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^TSK-[0-9]{3,}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[^\\n\\r]+$"
                },
                "category": {
                  "enum": [
                    "product",
                    "ux",
                    "tech",
                    "architecture",
                    "data",
                    "security",
                    "quality",
                    "docs",
                    "delivery",
                    "human"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "disposition": {
                  "enum": ["active", "blocked", "dropped"]
                },
                "derived_from": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^TSK-[0-9]{3,}$"
                  }
                },
                "origin": {
                  "enum": ["planned", "discovered"]
                },
                "source_work": {
                  "type": ["string", "null"],
                  "pattern": "^WORK-[0-9]{3,}$"
                },
                "origin_reason": {
                  "type": ["string", "null"]
                },
                "added_at": {
                  "type": ["string", "null"]
                },
                "blocked_reason": {
                  "type": ["string", "null"]
                },
                "dropped_by": {
                  "type": ["string", "null"]
                },
                "dropped_at": {
                  "type": ["string", "null"]
                },
                "dropped_reason": {
                  "type": ["string", "null"]
                },
                "evidence_log": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "kind",
                      "ref",
                      "recorded_at",
                      "observed_by",
                      "state",
                      "state_reason",
                      "state_at"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^EV-[0-9]{3,}$"
                      },
                      "kind": {
                        "enum": [
                          "report",
                          "test",
                          "decision",
                          "document",
                          "commit",
                          "observation"
                        ]
                      },
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^\\n\\r]+$"
                      },
                      "recorded_at": {
                        "type": "string",
                        "minLength": 1
                      },
                      "observed_by": {
                        "type": ["string", "null"]
                      },
                      "state": {
                        "enum": ["valid", "superseded", "invalidated"]
                      },
                      "state_reason": {
                        "type": ["string", "null"]
                      },
                      "state_at": {
                        "type": ["string", "null"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
